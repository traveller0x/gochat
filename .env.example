# 使用方式：cp .env.example .env，然后填入真实值
# .env 已被 .gitignore 忽略，可以放真实密钥；.env.example 会进仓库，只能放占位符

# --- docker compose 启动 MySQL 时使用 ---
MYSQL_ROOT_PASSWORD=change-me

# --- Go 程序运行时读取（注意：变量名不同，见 internal/config/config.go）---
GOCHAT_MYSQL_PASSWORD=change-me

# 至少 32 字节，可以用 `openssl rand -base64 48` 生成
GOCHAT_JWT_SECRET=please-generate-a-48-byte-random-secret

# --- docker compose 启动 Redis 时使用 ---
REDIS_PASSWORD=change-me

# --- Go 程序运行时读取（与上一行同一个值，变量名不同，见 internal/config/config.go）---
GOCHAT_REDIS_PASSWORD=change-me

# --- 运行环境：development / production（production 输出 JSON 日志）---
GOCHAT_ENV=development


# --- 限流 / 连接上限 / WS 来源白名单（可选，留空用默认值）---
GOCHAT_RATE_LIMIT_PER_SECOND=20
GOCHAT_RATE_LIMIT_BURST=40
GOCHAT_MAX_CONNECTIONS=10000

# 逗号分隔；留空表示开发期允许所有来源
GOCHAT_ALLOWED_ORIGINS=http://localhost:5173
